#!/usr/bin/env bash
# Wrapper for the ipmitool.py stub: invokes the interpreter explicitly
# instead of via a python shebang. Under MSYS/git-bash, kernel exec of a
# python-shebang script mangles the script path (C:\c\...), so the stub
# would die before parsing its args. On Linux the cygpath branch is a
# no-op (no cygpath installed) and the path passes through untouched.
d=$(cd "$(dirname "$0")" && pwd)
command -v cygpath >/dev/null 2>&1 && d=$(cygpath -w "$d")
exec python3 "$d/ipmitool.py" "$@"
