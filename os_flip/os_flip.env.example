# os_flip site config template.
#
# Two ways to create your local config:
#   1. ./discovery.sh            -- interactive, auto-finds what it can
#   2. cp os_flip.env.example os_flip.env   -- fill by hand
#
# os_flip.env is local-only: chmod 600, gitignored, never committed.
# CLI environment variables override everything in this file.

# --- DUT identity (at least one; the MAC is the stable identity) ---
DUT_IP=192.168.1.10            # current DUT IP (discovery resolves it from DUT_MAC)
DUT_MAC=00:15:b2:00:00:10      # DUT NIC MAC (recommended: survives DHCP drift)

# --- BMC ---
BMC_IP=192.168.1.11            # BMC IP (same-block neighbor of the DUT MAC)
BMC_USER=admin
BMC_PASS=

# --- DUT OS accounts (asked once on first run, stored here) ---
WIN_USER=Administrator
WIN_PASS=
UBU_USER=dqa
UBU_PASS=

# --- optional overrides ---
# DUT_NET=192.168.1.0/24       # MAC sweep range (default: runner's own /24)
# KNOWN_OUI=00:15:b2           # vendor OUI prefixes (comma-separated)
# RELAY_OFF_CMD=               # full command cutting the DUT's AC power
# RELAY_ON_CMD=                # full command restoring it
#                              (set BOTH to enable the power-off fingerprint)#
# --- os_flip.sh shutdown / timing overrides ---
# SHUTDOWN_MODE=clean           # clean = SSH shutdown -> off -> bootdev-while-off
#                               #         -> power on (COLD); reset = legacy warm
# SHUTDOWN_TIMEOUT=60           # budget (s) for the clean shutdown to reach off
# SETUP_TIMEOUT=120             # UEFI setup arrival budget (s)
# BOOT_TIMEOUT=240              # boot-confirmation budget (s)
#
# --- ac_cycle.sh overrides ---
# PRE_SHUTDOWN=1                # 1 (default): confirm power OFF before the relay
#                               #     cut (graceful; do NOT use 0 on Windows)
# AC_SETTLE=6                   # seconds the relay stays cut
# BMC_WAIT=180                  # budget (s) for the BMC back after the cut
